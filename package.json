{
  "name": "@theme-browser/registry",
  "version": "0.0.1",
  "type": "module",
  "description": "TypeScript theme indexer for theme-browser.nvim",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "sync": "tsx src/index.ts sync",
    "watch": "tsx src/index.ts watch",
    "publish": "tsx src/index.ts publish",
    "export": "tsx src/index.ts export",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "clean": "rm -rf dist coverage .state artifacts"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^11.7.0",
    "commander": "^13.1.0",
    "defu": "^6.1.4",
    "dotenv": "^17.3.1",
    "simple-git": "^3.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
