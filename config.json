{
  "version": "2.0.0",
  "discovery": {
    "topics": ["neovim-colorscheme", "nvim-theme", "vim-colorscheme", "neovim-theme"],
    "includeRepos": [
      "folke/tokyonight.nvim",
      "catppuccin/nvim",
      "rebelot/kanagawa.nvim",
      "eldritch-theme/eldritch.nvim",
      "morhetz/gruvbox",
      "dracula/vim",
      "sainnhe/everforest",
      "ayu-theme/ayu-vim",
      "projekt0n/github-nvim-theme",
      "rose-pine/neovim",
      "Mofiqul/vscode.nvim",
      "navarasu/onedark.nvim",
      "EdenEast/nightfox.nvim"
    ],
    "excludeRepos": [
      "veekram/vim"
    ],
    "pagination": {
      "perPage": 100,
      "maxPagesPerTopic": 5
    }
  },
  "github": {
    "rateLimit": {
      "delayMs": 250,
      "retryLimit": 3
    }
  },
  "processing": {
    "batch": {
      "size": 50,
      "pauseMs": 0
    },
    "concurrency": 5,
    "maxReposPerRun": 0
  },
  "filters": {
    "minStars": 10,
    "skipArchived": true,
    "skipDisabled": true,
    "staleAfterDays": 14
  },
  "output": {
    "index": "artifacts/index.json",
    "manifest": "artifacts/manifest.json",
    "cache": ".state/indexer.db"
  },
  "overrides": "overrides.json",
  "runtime": {
    "scanIntervalSeconds": 1800,
    "logLevel": "INFO"
  },
  "publish": {
    "enabled": false,
    "git": {
      "remote": "origin",
      "branch": "master",
      "message": "chore(registry): publish latest index artifacts"
    }
  }
}
